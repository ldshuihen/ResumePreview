# =====================================================================
# MarkResume (Spring Boot 3 + Vue 3) .gitignore
# =====================================================================

# -------------------- Java & Maven (backend/) --------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# -------------------- Runtime Database & Uploads --------------------
# H2 local database files
backend/data/
data/
*.mv.db
*.trace.db

# Uploaded avatar files
backend/uploads/
uploads/

# -------------------- Node & Vite (frontend/) --------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
.vite/
.eslintcache

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------- Environment Variables --------------------
.env
.env.*
!.env.example

# -------------------- IDEs & Editors --------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# -------------------- OS & Temp Files --------------------
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.bak
*.swp
*~

